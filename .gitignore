# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase (CLI local cache / linked-project state)
/supabase/.temp
/supabase/.branches

# typescript
*.tsbuildinfo
next-env.d.ts

# Local agent instructions stay on developer machines.
/CLAUDE.md

# Local render/debug scratch (audit frames, OCR dumps, smoke logs — never commit).
/tmp/

# Local Build Week research, source media, and working artefacts.
/.playwright-mcp/
/Codex OpenAI Build Week Research.md
/docs/codex-context-prompt.md
/docs/superpowers/
/PEEKABOO-DEMO.mp4
/Proof Helps Developers Build in Public Videos.mp4
/Proof demo trial/
/SUTD Deadline Centre demo/
/branding/
/env
/peekaboo-demo/
/proof — Build2026 pitch.pdf
/proof-render-prd.md
/public/demo-output.mp4
/render/scripts/task6-e2e.ts
/ugc-proof.zip
/ugc-proof/
/weekend-build-log-making-peekaboo-less-l.json

# Local capture output: rendered videos, extracted frames, e2e screenshots. These hold real
# user recordings and run to hundreds of MB, so a stray `git add -A` should never sweep them in.
/*-shots/
/asset-proof-shots/
/scene-eyeball/
