# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI and GitHub
OPENAI_API_KEY=
GITHUB_TOKEN=

# Web model overrides
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_MINI_MODEL=gpt-5.6-luna
OPENAI_SEARCH_MODEL=gpt-5.6-sol

# Render model overrides
PREMIUM_PLAN_MODEL=gpt-5.6-sol
PREMIUM_AUTHOR_MODEL=gpt-5.6-sol
PREMIUM_QA_MODEL=gpt-5.6-sol
BRIEF_VISUAL_MODEL=gpt-5.6-luna

# Render policy
RENDER_SERVICE_URL=http://localhost:8080
RENDER_TOKEN=
RENDER_EDIT_MODE=generated-experimental
RENDER_CONCURRENCY=2
PREMIUM_CONCURRENCY=2
PREMIUM_MAX_QA_ITERS=2
PREMIUM_OPENAI_TIMEOUT_MS=90000
PREMIUM_ASSET_HOSTS=

# Product limits
RESEARCH_DAILY_LIMIT=10
EDIT_LIFETIME_CAP=3

# Optional pre-rendered demo path
NEXT_PUBLIC_DEMO_RENDER_URL=
